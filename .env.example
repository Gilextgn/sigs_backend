APP_NAME="SIGS Admin"
APP_ENV=local
APP_KEY=base64:pktRbvhiFZHPs8XXFJjZhg/PIKdv1Ds6QiEN1ItQdVY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Clé pour le chiffrement applicatif historique (compat AES-256-GCM, 32 octets en base64)
APP_ENCRYPTION_KEY=

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sigs_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_IDLE_TIMEOUT_SECONDS=600
SESSION_SECURE_COOKIE=false

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,127.0.0.1:5173
FRONTEND_URLS=http://localhost:5173

CACHE_STORE=database
QUEUE_CONNECTION=database

# Compte du propriétaire de la plateforme (console des établissements),
# créé au démarrage. Une fois le mot de passe changé dans la console, le
# redémarrage ne l'écrase plus. Accès perdu : PLATFORM_OWNER_RESET_PASSWORD=true,
# redémarrer, se connecter, puis retirer la variable.
PLATFORM_OWNER_EMAIL=
PLATFORM_OWNER_PASSWORD=
PLATFORM_OWNER_NAME="Propriétaire SIGS"
PLATFORM_OWNER_RESET_PASSWORD=false
